{
  "compilerOptions": {
    "composite": true,
    "target": "esnext",
    "lib": ["ESNext"],
    "module": "nodenext",
    "declaration": true,
    "sourceMap": true,
    "outDir": "build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "src/**/*"],
  "exclude": ["build/**/*"]
}
